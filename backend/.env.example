# Backend server-side only. Configure real values only in the server's secret store or ignored .env.local.
FILTROX_ENVIRONMENT=development
FILTROX_LOGIN_EMAIL=
# Generate with: python backend/scripts/hash_password.py
FILTROX_LOGIN_PASSWORD_HASH=
# Use a random secret of at least 32 bytes, shared with the Next.js server environment.
FILTROX_SESSION_SECRET=
# The app renews the session on activity; it expires after 30 idle days.
# false only for local HTTP development; production must use true/HTTPS.
FILTROX_COOKIE_SECURE=false
FILTROX_WEB_ORIGINS=
DATABASE_URL=
REDIS_URL=
CATALOG_CSV_URL=
CATALOG_REMOVAL_CSV_URL=
# Planned source only: no parser or network call until official schema/privacy review is approved.
FILTROX_ENABLE_PORNHUB=false
PORNHUB_CATALOG_CSV_URL=
